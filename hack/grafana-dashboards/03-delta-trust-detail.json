{
  "title": "NMA vs PNE \u2014 Delta & Trust Detail",
  "uid": "nma-pne-delta",
  "tags": [
    "parity"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "V2 invariants \u2014 absolute delta (MUST be flat zero)",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "abs(node_memory_MemTotal_bytes{job=\"pne\"} - on(instance) node_memory_MemTotal_bytes{job=\"nma\"})",
          "legendFormat": "MemTotal {{instance}}",
          "range": true,
          "refId": "A",
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "abs(node_boot_time_seconds{job=\"pne\"} - on(instance) node_boot_time_seconds{job=\"nma\"})",
          "legendFormat": "boot_time {{instance}}",
          "range": true,
          "refId": "B",
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "abs(node_filesystem_size_bytes{job=\"pne\"} - on(instance,device,fstype,mountpoint) node_filesystem_size_bytes{job=\"nma\"})",
          "legendFormat": "fs_size {{mountpoint}}",
          "range": true,
          "refId": "C",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Any non-zero value here is a genuine defect, not sampling noise."
    },
    {
